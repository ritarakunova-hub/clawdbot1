        1360,
        80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\":true,\"duplicate\":true}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-duplicate-node",
