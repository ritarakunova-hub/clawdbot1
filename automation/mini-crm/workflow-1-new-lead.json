{
  "name": "TAINA — Новая заявка с сайта",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "YOUR_RANDOM_WEBHOOK_PATH",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-node",
      "name": "Webhook (от Netlify)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "taina-new-lead"
    },
    {
      "parameters": {
        "jsCode": "// Keep the original raw request body: Netlify signs the exact JSON bytes.\nconst item = $input.first();\nconst headers = item.json && item.json.headers ? item.json.headers : {};\nconst signature = headers['x-webhook-signature'] || headers['X-Webhook-Signature'] || '';\nconst rawBodyBase64 = item.binary && item.binary.data && item.binary.data.data\n  ? item.binary.data.data\n  : '';\n\nreturn [{\n  json: {\n    action: 'receiveSignedNetlifyLead',\n    token: 'YOUR_WEBHOOK_TOKEN',\n    signature,\n    rawBodyBase64\n  }\n}];"
      },
      "id": "normalize-node",
      "name": "Подготовить подписанную заявку",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "YOUR_APPS_SCRIPT_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          }
        }
      },
      "id": "sheet-node",
      "name": "Проверить Netlify JWS и сохранить заявку",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "onError": "continueErrorOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🆕 Новая заявка TAINA сохранена в таблицу.\n\nID строки: {{ $('Проверить Netlify JWS и сохранить заявку').item.json.id }}\nФорма: taina-diagnostic\n\nКонтактные данные и текст обращения доступны только в рабочей таблице.",
        "additionalFields": {}
      },
      "id": "telegram-ok-node",
      "name": "Уведомление: заявка записана (без PII)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1540,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=⚠️ Входящая заявка не принята или не сохранена. Код: {{ $('Проверить Netlify JWS и сохранить заявку').item.json.error || 'processing_error' }}. Проверьте execution в n8n; персональные данные не пересылаются в Telegram.",
        "additionalFields": {}
      },
      "id": "telegram-error-node",
      "name": "Уведомление: отказ / ошибка (без PII)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1540,
        620
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "accepted-if-node",
      "name": "Заявка принята?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.duplicate === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "duplicate-if-node",
      "name": "Повторная доставка?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.error === 'invalid_netlify_signature' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "signature-error-if-node",
      "name": "Подпись Netlify неверна?",
