{
  "name": "TAINA Sales Engine — Обработка Одобрить/Отклонить",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "updates": [
          "callback_query"
        ]
      },
      "id": "telegram-trigger-node",
      "name": "Нажатие кнопки в Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "webhookId": "taina-approval",
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst cq = body.callback_query || (body.body && body.body.callback_query);\nif (!cq || !cq.id) {\n  throw new Error('Событие без callback_query.id — нельзя безопасно обработать callback');\n}\n\nconst match = String(cq.data || '').match(/^(approve|reject):([1-9][0-9]*)$/);\nconst chat = cq.message && cq.message.chat ? cq.message.chat : {};\nconst approverId = String(cq.from && cq.from.id || '');\nconst chatId = String(chat.id || '');\nconst messageId = String(cq.message && cq.message.message_id || '');\nconst privateChat = chat.type === 'private';\nconst numericIds = /^[1-9][0-9]*$/;\n\nconst valid = Boolean(\n  match &&\n  privateChat &&\n  numericIds.test(approverId) &&\n  /^[1-9][0-9]*$/.test(chatId) &&\n  numericIds.test(messageId)\n);\n\nconst action = valid ? match[1] : '';\nconst id = valid ? match[2] : '';\nconst approved = action === 'approve';\n\nreturn [{\n  json: {\n    valid,\n    callbackQueryId: String(cq.id),\n    reason: valid ? '' : 'invalid_or_unauthorized_callback_shape',\n    id,\n    status: approved ? 'Одобрено' : (action === 'reject' ? 'Отклонено' : ''),\n    mark: approved ? '✅ Одобрено' : (action === 'reject' ? '❌ Отклонено' : ''),\n    approverId,\n    chatId,\n    messageId,\n    originalText: String(cq.message && cq.message.text || '')\n  }\n}];"
      },
      "id": "parse-callback-node",
      "name": "Разобрать нажатие",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "YOUR_APPS_SCRIPT_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { action: 'updateStatus', token: 'YOUR_WEBHOOK_TOKEN', id: $json.id, status: $json.status, approverId: $json.approverId, chatId: $json.chatId, messageId: $json.messageId } }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "timeout": 30000
        }
      },
      "id": "update-status-node",
      "name": "Обновить статус в таблице",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "onError": "continueErrorOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "chatId": "={{ $('Разобрать нажатие').item.json.chatId }}",
        "text": "=⚠️ Не удалось обновить статус для ID {{ $('Разобрать нажатие').item.json.id }} в таблице. Проверьте вручную.",
        "additionalFields": {}
      },
      "id": "telegram-error-node",
