      "parameters": {
        "jsCode": "// Normalize untrusted Outscraper records and bound every field before later use.\nconst response = $input.first().json;\nlet list = [];\nif (Array.isArray(response.data) && response.data.length && Array.isArray(response.data[0])) {\n  list = response.data[0];\n} else if (Array.isArray(response.data)) {\n  list = response.data;\n} else if (Array.isArray(response)) {\n  list = response;\n}\n\nfunction bounded(value, maxLength) {\n  if (value === null || value === undefined) return '';\n  if (typeof value !== 'string' && typeof value !== 'number') return '';\n  return String(value).trim().slice(0, maxLength);\n}\n\nreturn list\n  .filter((record) => record && typeof record === 'object' && !Array.isArray(record))\n  .map((record) => ({\n    json: {\n      company: bounded(record.name || record.title, 200) || '—',\n      site: bounded(record.site || record.website, 500),\n      industry: bounded(record.category || record.type, 160),\n      address: bounded(record.full_address || record.address, 300)\n    }\n  }));"
      },
