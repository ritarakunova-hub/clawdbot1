    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response.choices?.[0]?.message?.content || response.content || '';\nconst content = typeof raw === 'string' ? raw.trim() : '';\nconst source = $('По одной компании').item.json;\n\nfunction grab(labelPattern) {\n  const re = new RegExp(\n    '^' + labelPattern + '\\\\s*:\\\\s*([\\\\s\\\\S]*?)(?=\\\\n\\\\s*[А-ЯЁA-Z][А-ЯЁA-Z \\\\(\\\\)0-9]*\\\\s*:|$)',\n    'im'\n  );\n  const match = content.match(re);\n  return match ? match[1].trim() : '';\n}\n\nconst facts = grab('ФАКТЫ');\nconst scoreText = grab('SCORE');\nconst scoreMatch = scoreText.match(/^(?:100|[1-9]?\\d)$/);\nconst score = scoreMatch ? Number(scoreText) : null;\nconst scoreReason = grab('ПОЧЕМУ ТАКОЙ SCORE');\nconst hypothesis = grab('ГИПОТЕЗА\\\\s*\\\\(ПРОБЛЕМА\\\\)') || grab('ГИПОТЕЗА');\nconst solution = grab('ВОЗМОЖНОЕ РЕШЕНИЕ');\nconst hook = grab('ЗАЦЕПКА ДЛЯ ПЕРСОНАЛИЗАЦИИ');\n\nfunction clipText(value, maxLength) {\n  const text = String(value || '').replace(/[\\r\\n\\t]+/g, ' ').replace(/\\s{2,}/g, ' ').trim();\n  return text.length > maxLength\n    ? text.slice(0, maxLength - 1).trimEnd() + '…'\n    : text;\n}\n\nconst errors = [];\nif (!content) errors.push('empty_response');\nif (!Number.isInteger(score) || score < 0 || score > 100) errors.push('score_must_be_integer_0_100');\nif (!facts) errors.push('facts_missing');\nif (!scoreReason) errors.push('score_reason_missing');\nif (!hypothesis) errors.push('hypothesis_missing');\nif (!solution) errors.push('solution_missing');\nif (!hook) errors.push('personalization_hook_missing');\nif (facts.length > 2500 || scoreReason.length > 1000 ||\n    hypothesis.length > 1500 || solution.length > 1500 || hook.length > 800) {\n  errors.push('model_field_too_long');\n}\n\nconst company = String(source.company || '').trim();\nconst industry = String(source.industry || '').trim();\nconst site = String(source.site || '').trim();\nif (!company || company === '—' || company.length > 200) errors.push('source_company_invalid');\nif (industry.length > 160 || site.length > 500) errors.push('source_field_too_long');\n\n// Telegram message bodies are limited to 4096 characters. Keep a conservative\n// card budget while preserving the full validated hypothesis/solution for Sheets.\nconst displayCompany = clipText(company, 200);\nconst displayIndustry = clipText(industry, 160);\nconst displaySite = clipText(site, 250);\nconst cardFacts = clipText(facts, 1000);\nconst cardScoreReason = clipText(scoreReason, 350);\nconst cardHypothesis = clipText(hypothesis, 450);\nconst cardSolution = clipText(solution, 450);\nconst cardHook = clipText(hook, 250);\nconst truncatedFields = [];\nif (facts.length > 1000) truncatedFields.push('facts');\nif (scoreReason.length > 350) truncatedFields.push('scoreReason');\nif (hypothesis.length > 450) truncatedFields.push('hypothesis');\nif (solution.length > 450) truncatedFields.push('solution');\nif (hook.length > 250) truncatedFields.push('hook');\nif (site.length > 250) truncatedFields.push('site');\nconst cardText = [\n  `🎯 Новый лид (Score: ${score})`,\n  `Компания: ${displayCompany}`,\n  `Отрасль: ${displayIndustry || '—'}`,\n  `Сайт: ${displaySite || '—'}`,\n  `Факты: ${cardFacts}`,\n  `Почему такой score: ${cardScoreReason}`,\n  `Гипотеза: ${cardHypothesis}`,\n  `Что предложить: ${cardSolution}`,\n  `Зацепка: ${cardHook}`\n].join('\\n\\n');\nif (cardText.length > 3800) errors.push('telegram_card_too_long');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    validationErrors: errors,\n    company,\n    site,\n    displaySite,\n    industry,\n    facts,\n    score,\n    scoreReason,\n    hypothesis,\n    solution,\n    hook,\n    truncatedFields,\n    cardText\n  }\n}];"
      },
